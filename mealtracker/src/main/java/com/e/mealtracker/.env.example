# ============================================
# БАЗА ДАННЫХ
# ============================================
DB_URL=jdbc:postgresql://localhost:5432/mealtracker_db
DB_USERNAME=your_username
DB_PASSWORD=your_password

# ============================================
# JWT (сгенерируйте свой секрет длиной 32+ символов)
# ============================================
JWT_SECRET=your_jwt_secret_key_min_32_characters_long

# ============================================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ============================================
APP_INIT_DEMO_DATA=true
APP_DEMO_DEFAULT_USERNAME=demo_user

# ============================================
# ЛОГИРОВАНИЕ
# ============================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_LIQUIBASE=DEBUG
LOGGING_LEVEL_ORG_HIBERNATE_SQL=DEBUG

# ============================================
# SWAGGER
# ============================================
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# ============================================
# SQL
# ============================================
SHOW_SQL=true