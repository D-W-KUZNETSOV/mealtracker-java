# Скопируй этот файл в .env и заполни своими значениями

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/mealtracker_db
DB_USERNAME=your_username
DB_PASSWORD=your_password

# JWT (минимум 32 байта, base64)
# Сгенерировать: PowerShell — [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
JWT_SECRET=generate_with_powershell_command

# Demo data (только для local, в проде false)
APP_INIT_DEMO_DATA=false